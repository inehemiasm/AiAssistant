rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Public Model Catalog (read-only for clients)
    // -------------------------------------------------------------------------
    match /models/{modelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // AI-Generated Content Reports (create-only with strict schema validation)
    // -------------------------------------------------------------------------
    match /ai_content_reports/{reportId} {
      // Public intake stays closed until verified app/server intake is deployed.
      // Schema validation alone does not authenticate or rate-limit a sender.
      allow create: if false;
      allow get, list, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
